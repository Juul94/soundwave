# Supabase project (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only: admin invites and user management. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Base URL used in invite and password-reset links, e.g. http://localhost:3000
SITE_URL=
# Optional upload limit in MB (the bucket limit is 50)
NEXT_PUBLIC_MAX_AUDIO_MB=
